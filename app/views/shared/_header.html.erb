<header class="header_section">
  <div class="header_top">
    <div class="container-fluid">
      <div class="top_nav_container">
        <div class="contact_nav">
          <a href="#">
            <i class="fa fa-phone" aria-hidden="true"></i>
            <span>Call : +01 123455678990</span>
          </a>
          <a href="#">
            <i class="fa fa-envelope" aria-hidden="true"></i>
            <span>Email : info@studentmart.com</span>
          </a>
        </div>
        <form class="search_form" action="#" method="get">
          <input type="text" class="form-control" placeholder="Search here...">
          <button type="submit">
            <i class="fa fa-search" aria-hidden="true"></i>
          </button>
        </form>
        <% if user_signed_in? %>
          <div class="user_option_box">
            <%= button_to 'Add To Cart', cart_items_path(product_id: product.id), method: :post, class: "add_cart_btn" do %>
  <span>Add To Cart</span>
<% end %>

            <div class="dropdown account-dropdown">
              <a href="#" class="account-link dropdown-toggle action_link" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="fa fa-user" aria-hidden="true"></i>
                <span>
                  My Account
                </span>
              </a>
              <div class="dropdown-menu dropdown-menu-right">
                <%= link_to 'Profile', edit_user_registration_path, class: "dropdown-item" %>
                <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: "dropdown-item" %>
              </div>
            </div>
          </div>
        <% else %>
          <div class="mb-3 mb-md-0">
            <%= link_to "Login", new_user_session_path, class: "user_login_button" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "user_login_button ml-2" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="header_bottom">
    <div class="container-fluid">
      <nav class="navbar navbar-expand-lg custom_nav-container">
        <%= link_to "<span>StudentMart</span>".html_safe, root_path, class: "navbar-brand" %>

        <button class="navbar-toggler" type="button" data-toggle="collapse"
                data-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
          <span></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav">
            <li class="nav-item active">
              <%= link_to "Home", root_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "About", about_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Products", products_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Why Us", why_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Testimonial", testimonial_path, class: "nav-link" %>
            </li>
          </ul>
        </div>
      </nav>
    </div>
  </div>
</header>
